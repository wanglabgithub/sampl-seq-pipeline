# The parent config/output/<analysis>/ folder determines the analysis ID.
# Step 01 automatically uses input/<analysis>/ and creates output/<analysis>/.
# By default, R1 files must be named <sample_id>_R1.fastq.gz. To use a
# nonstandard filename or merge multiple lanes, copy config/samples.tsv.example into
# this folder and uncomment the optional manifest override below.
# SAMPLES_TSV=config/output/${ANALYSIS_ID}/samples.tsv

# Other relative paths are interpreted from the repository root.
USEARCH_BIN=software/usearch12

THREADS=16
FASTQ_MIN_LENGTH=150
FASTQ_MAX_EE=1.0
ULTRAPLEX_MIN_LENGTH=84
ULTRAPLEX_MIN_Q=20
PRIMER_SEQUENCE=YCAGCMGCCGCGGTAA
AMPLICON_RANGE=1:240
TRIM_LENGTH=68
INFERENCE_MAX_EE=0.1
UNOISE_MINSIZE=8
ASV_MAPPING_ID=1.0

# Remove regenerable intermediate files after successful completion.
# Set to false to retain every intermediate file for debugging.
CLEAN_INTERMEDIATES=true

# Optional taxonomy assignment. This reproduces the original SAMPL-seq
# RDP v18/SINTAX settings. Set TAXONOMY_DB= to skip this step.
TAXONOMY_DB=database/rdp_16s_v18/rdp_16s_v18.udb
SINTAX_CUTOFF=0.8
